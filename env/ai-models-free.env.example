# ThreadBoss V1.7 - FREE-TIER AI MODEL MATRIX
# Share this with anyone integrating a channel. Only the CENTRAL backend needs these keys.

# Free Google AI Studio key (default provider)
GEMINI_API_KEY=

# Optional free alternatives
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Knowledge Agent
KNOWLEDGE_PROVIDER=gemini
KNOWLEDGE_MODEL=gemini-3.5-flash-lite

# Planner Agent
PLANNER_PROVIDER=gemini
PLANNER_MODEL=gemini-3.5-flash-lite

# Follow-up Agent
FOLLOWUP_PROVIDER=cloudflare
FOLLOWUP_MODEL=@cf/zai-org/glm-4.7-flash

# Action Agent
ACTION_PROVIDER=gemini
ACTION_MODEL=gemini-3.5-flash-lite

# Optional AI router; keep disabled to save quota
ROUTER_PROVIDER=cloudflare
ROUTER_MODEL=@cf/zai-org/glm-4.7-flash
ENABLE_AI_ROUTER=false

# Vision
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# RAG embeddings
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Optional Groq free-plan fallback model if you switch an agent manually:
# KNOWLEDGE_PROVIDER=groq
# KNOWLEDGE_MODEL=qwen/qwen3.6-27b
GEMINI_MODEL_FALLBACKS_CSV=gemini-3.5-flash-lite,gemini-3.1-flash-lite
AUTO_SYNC_TEMPORAL_QUERIES=true
TEMPORAL_SYNC_CACHE_SECONDS=900
INITIAL_BACKFILL_HOURS=48
INITIAL_BACKFILL_MAX_MESSAGES=3000
