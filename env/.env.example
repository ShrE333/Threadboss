# ============================================================
# ThreadBoss V1.3 - Agents Core (FREE-TIER configuration)
# Copy to .env for local use. Never commit real secrets.
# No paid OpenAI/Anthropic API is required.
# Free tiers have quotas and providers can change them.
# ============================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000

# ---------- WAHA / WhatsApp ----------
WAHA_BASE_URL=https://YOUR-WAHA-DOMAIN
WAHA_API_KEY=
WAHA_WEBHOOK_HMAC_KEY=
SESSION_TENANTS_JSON={"YOUR_WAHA_SESSION":"tenant_shriram"}
ADMIN_TOKEN=

# Used by Slack / Telegram adapters to call /v1/messages and /v1/query
CHANNEL_API_KEY=

# ---------- FREE database on your existing GCP VM ----------
POSTGRES_PASSWORD=threadboss-dev
DATABASE_URL=postgresql://threadboss:threadboss-dev@postgres:5432/threadboss

# ---------- Redis on your existing GCP VM ----------
REDIS_URL=redis://redis:6379/0
REDIS_STREAM=threadboss:events
REDIS_CONSUMER_GROUP=threadboss-workers
REDIS_CONSUMER_NAME=worker-1
REDIS_DEADLETTER_STREAM=threadboss:deadletter
WORKER_MAX_ATTEMPTS=4
WORKER_RETRY_BASE_SECONDS=2

# ============================================================
# FREE AI PROVIDERS
# Fill at least GEMINI_API_KEY for the default config.
# Optional Groq/Cloudflare keys are free-tier alternatives.
# ============================================================

# Google AI Studio free tier
GEMINI_API_KEY=

# Groq Free plan (optional)
GROQ_API_KEY=

# Cloudflare Workers AI Free allocation (optional)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

AI_TIMEOUT_SECONDS=60

# ---------- Agent models (all free-tier-capable defaults) ----------
KNOWLEDGE_PROVIDER=gemini
KNOWLEDGE_MODEL=gemini-3.5-flash-lite

PLANNER_PROVIDER=gemini
PLANNER_MODEL=gemini-3.5-flash-lite

FOLLOWUP_PROVIDER=cloudflare
FOLLOWUP_MODEL=@cf/zai-org/glm-4.7-flash

ACTION_PROVIDER=gemini
ACTION_MODEL=gemini-3.5-flash-lite

ROUTER_PROVIDER=cloudflare
ROUTER_MODEL=@cf/zai-org/glm-4.7-flash

VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Free Gemini embedding tier. 768 dimensions = compact pgvector storage.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
KNOWLEDGE_TOP_K=8
MIN_EMBED_CHARS=4

# Keep AI router off to save free quota; simple routing handles most requests.
ENABLE_AI_ROUTER=false
ENABLE_PLANNER_EXTRACTION=true

# V1.4 native WhatsApp tap menu
INTERACTIVE_MENU_ENABLED=true
INTERACTIVE_MENU_POLL_FALLBACK=true
MENU_STATE_TTL_SECONDS=600

# ---------- Media / voice / OCR (local, no API cost) ----------
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=60
MAX_MEDIA_MB=25
MAX_DOCUMENT_PAGES=50
MEDIA_CONTEXT_MAX_CHARS=12000
ATTACHMENT_MEMORY_SECONDS=600
ATTACHMENT_MEMORY_MAX_ITEMS=20
ENRICH_NORMAL_CHAT_MEDIA=false

ENABLE_LOCAL_STT=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CACHE_DIR=/root/.cache/huggingface
VISION_TIMEOUT_SECONDS=60

# ===== V1.6 RELIABLE MEMORY =====
DEFAULT_TIMEZONE=Asia/Kolkata
KNOWLEDGE_SUMMARY_LIMIT=120
INITIAL_BACKFILL_HOURS=48
INITIAL_BACKFILL_MAX_MESSAGES=3000
HISTORY_SYNC_PAGE_SIZE=100
INDEX_NORMAL_CHAT_IMAGES=true
INDEX_NORMAL_CHAT_DOCUMENTS=true
INDEX_NORMAL_CHAT_AUDIO=false
WAHA_REQUEST_RETRIES=4
WAHA_RETRY_BASE_SECONDS=0.75
GEMINI_MODEL_FALLBACKS_CSV=gemini-3.5-flash-lite,gemini-3.1-flash-lite
AUTO_SYNC_TEMPORAL_QUERIES=true
TEMPORAL_SYNC_CACHE_SECONDS=900
