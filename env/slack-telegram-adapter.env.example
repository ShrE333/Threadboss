# Slack/Telegram adapters do NOT need AI keys.
# Create one tenant-scoped token through POST /v1/onboarding/channel-token.
THREADBOSS_API_URL=https://YOUR-THREADBOSS-DOMAIN
THREADBOSS_CHANNEL_API_KEY=tbk_TENANT_SCOPED_TOKEN

# The token determines the tenant. Do not trust a user-supplied tenant id.
# THREADBOSS_TENANT_ID is optional metadata for logs/UI only.
THREADBOSS_TENANT_ID=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=

TELEGRAM_BOT_TOKEN=
